// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "alt-shift-e": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-b": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-b": "search::ToggleRegex"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-r": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-?": "agent::ToggleFocus"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt->": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "alt->": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "alt->": "agent::AddSelectionToThread"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-l": "workspace::ActivateNextPane"
    }
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-h": "workspace::ActivatePreviousPane"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "ctrl-j": "editor::AcceptNextLineEditPrediction"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-r": [
        "terminal::SendKeystroke",
        "ctrl-r"
      ]
    }
  },
  {
    "context": "Terminal",
      "bindings": {
      "ctrl-r": "terminal::RenameTerminal"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "%": "project_panel::NewFile"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "r": "project_panel::Rename"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "shift-r": "project_panel::Rename"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "d": "project_panel::Delete"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "shift-d": "project_panel::Delete"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-shift-a": "workspace::AddFolderToProject"
    }
  },
  {
    "context": "RecentProjects || RecentProjects > Picker > Editor",
    "unbind": {
      "ctrl-shift-a": "workspace::AddFolderToProject"
    }
  },
  {
    "context": "ProjectPanel&&not_editing",
    "bindings": {
      "ctrl-shift-d": "project_panel::RemoveFromProject"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w h": "workspace::ActivatePaneLeft"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "ctrl-w h": "pane::SplitHorizontal"
    }
  },
  {
    "context": "(VimControl && !menu) || (!Editor && !Terminal)",
    "unbind": {
      "ctrl-w s": "pane::SplitHorizontal"
    }
  }
]
